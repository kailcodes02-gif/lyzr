{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "content-maker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Auth lives in Next middleware (kept on the deprecated middleware.ts
    // convention on purpose — Next 16's newer "proxy" primitive can't run
    // on the Edge runtime, and OpenNext's Cloudflare adapter requires Edge)
    // — the Worker must see every request before static assets are served,
    // or a prerendered page bypasses the login redirect entirely.
    "run_worker_first": true
  },
  // Path-mount on the existing static site's domain: everything under
  // /content_maker hits this Worker; all other paths keep hitting the
  // Pages project (same pattern as GSI Tracker's route on this zone).
  "routes": [
    { "pattern": "lyzr.kailash-gm.com/content_maker*", "zone_name": "kailash-gm.com" }
  ],
  // Plain-text (non-secret) vars live here, source-controlled, so they
  // survive every deploy. Cloudflare's Git-integrated Workers Builds
  // treats this block as the authoritative full set of plain-text vars —
  // anything added only via the dashboard (not here) gets wiped on the
  // next Git-triggered deploy, while "Secret" type bindings persist
  // independently and stay dashboard-only. GOOGLE_CLIENT_ID and the
  // Supabase anon/publishable key are both meant to be public-safe (by
  // the NEXT_PUBLIC_ convention already used for the other two), so
  // committing them here is fine — the actual secrets stay in the
  // dashboard's encrypted "Secret" bindings.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://lyzr.kailash-gm.com/content_maker",
    "NEXT_PUBLIC_BASE_PATH": "/content_maker",
    "NEXT_PUBLIC_SUPABASE_URL": "https://zprmplleurbhsqlgvaof.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_LZDyrQNu2uWNFRZQsruLSg_vRkgOwQt",
    "GOOGLE_CLIENT_ID": "156143725737-pmf0te2rfcre8t5ipl1413en1no8tmi7.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": true
  }
}
