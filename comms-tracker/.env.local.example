# Public — safe to expose in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://datdjabcrxveubsvvxvm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose these client-side. For local `next dev` these
# read from .env.local; on Cloudflare they're set via `wrangler secret put`.
SUPABASE_SERVICE_ROLE_KEY=
HUBSPOT_ACCESS_TOKEN=
INSTANTLY_API_KEY=
CORTEX_API_KEY=
CORTEX_BASE_URL=https://applied-ai.lyzr.app
ANTHROPIC_API_KEY=

# Optional — knowledge-base ingestion no-ops for a source until its secret is
# set (see SETUP_INTEGRATIONS.md for how to obtain each one).
SLACK_BOT_TOKEN=
# Same Google OAuth client already configured for Supabase's Google SSO
# provider — reused for Drive's per-user consent flow, not a second client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Azure app registration for the Outlook mailbox connection (SETUP_INTEGRATIONS.md)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_SECRET=
